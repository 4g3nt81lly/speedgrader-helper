{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"paths": {
			"#models/*": ["./src/models/*"],
			"#schemas/*": ["./src/schemas/*"],
			"#shared/*": ["./src/shared/*"],
			"#pages/*": ["./src/pages/*"],
			"#content/*": ["./src/services/content/*"]
		},
		"jsx": "react-jsx",
		"composite": true
	},
	"include": [
		"src/pages",
		"src/services/content",
		"src/models",
		"src/schemas",
		"src/shared"
	],
	"exclude": ["src/shared/utils/worker"]
}
