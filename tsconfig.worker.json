{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "WebWorker"],
		"paths": {
			"#models/*": ["./src/models/*"],
			"#schemas/*": ["./src/schemas/*"],
			"#shared/*": ["./src/shared/*"],
			"#background/*": ["./src/services/background/*"]
		},
		"composite": true
	},
	"include": [
		"src/services/background",
		"src/models",
		"src/schemas",
		"src/shared"
	],
	"exclude": ["src/shared/utils/browser"]
}
