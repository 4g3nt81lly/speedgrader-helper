{
    "useTabs": true,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "arrowParens": "always",
    "objectWrap": "preserve",
    "overrides": [
        {
            "files": ["**/*.ts"],
            "options": {
                "printWidth": 90
            }
        },
        {
            "files": ["**/*.tsx"],
            "options": {
                "printWidth": 100
            }
        }
    ],
    "plugins": ["prettier-plugin-tailwindcss"]
}