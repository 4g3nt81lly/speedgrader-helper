		"@mui/icons-material": "^9.0.1",
		"@mui/joy": "^5.0.0-beta.52",
		"@mui/material": "^9.0.1",
		"@reduxjs/toolkit": "^2.12.0",
		"@tailwindcss/vite": "^4.3.0",
		"cheerio": "^1.2.0",
		"decimal.js": "^10.6.0",
