{
	"name": "speedgrader-helper",
	"version": "0.1-alpha",
	"description": "A Chrome extension that makes Canvas SpeedGrader infinitely better.",
	"type": "module",
	"scripts": {
		"dev": "BUILD_MODE=development tsx build.ts",
		"typecheck": "tsc -b",
		"build": "tsc -b && tsx build.ts",
		"clean": "rm -rf dist",
		"clean:dev": "rm -rf build",
		"prettier:check": "prettier \"$(cat .prettierglob)\" --ignore-path=.prettierignore --check",
		"prettier:format": "prettier \"$(cat .prettierglob)\" --ignore-path=.prettierignore --write --list-different",
		"docs:dev": "pnpm -F docs start",
		"docs:build": "pnpm -F docs build",
		"docs:serve": "pnpm -F docs serve",
		"docs:clean": "pnpm -F docs run clean"
	},
	"devDependencies": {
		"@babel/plugin-proposal-decorators": "^8.0.2",
		"@dotenvx/dotenvx": "^1.75.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/postcss": "^4.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/chrome": "^0.1.42",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/devtools": "^0.3.1",
		"@vitejs/plugin-react": "^6.0.2",
		"autoprefixer": "^10.5.0",
		"concurrently": "^10.0.3",
		"fast-glob": "^3.3.3",
		"fs-extra": "^11.3.5",
		"postcss": "^8.5.14",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"socket.io": "^4.8.3",
		"socket.io-client": "^4.8.3",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.13",
		"vite-plugin-tailwind-shadowdom": "^1.1.1"
	},
	"dependencies": {
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.0.1",
		"@mui/joy": "^5.0.0-beta.52",
		"@mui/material": "^9.0.1",
		"cheerio": "^1.2.0",
		"decimal.js": "^10.6.0",
		"idb": "^8.0.3",
		"motion": "^12.40.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-error-boundary": "^6.1.2",
		"react-hotkeys-hook": "^5.3.3",
		"sonner": "^2.0.8",
		"uuid": "^14.0.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	}
}
